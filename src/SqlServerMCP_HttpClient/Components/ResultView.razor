@using System.Text.Json
@using System.Text.Json.Nodes
@using ModelContextProtocol.Protocol

@if (Result is null)
{
    return;
}

@if (Result.IsError == true)
{
    <div class="alert alert-danger">The tool reported an error.</div>
}

@{
    var node = ExtractNode(Result, out var rawText);
}

@if (node is null)
{
    @if (!string.IsNullOrWhiteSpace(rawText))
    {
        <pre class="border rounded p-2 bg-light">@rawText</pre>
    }
    else
    {
        <p class="text-muted"><em>(no content returned)</em></p>
    }
}
else if (node is JsonObject obj && obj["Error"] is JsonValue error)
{
    <div class="alert alert-danger">@error.ToString()</div>
}
else if (node is JsonObject envelope && envelope["Rows"] is JsonArray rows)
{
    <dl class="row mb-3">
        @foreach (var prop in envelope.Where(p => p.Key != "Rows"))
        {
            <dt class="col-sm-3 text-muted">@prop.Key</dt>
            <dd class="col-sm-9">@(prop.Value?.ToJsonString() ?? "null")</dd>
        }
    </dl>
    @RenderRows(rows)
}
else if (node is JsonArray array)
{
    @RenderRows(array)
}
else
{
    <pre class="border rounded p-2 bg-light">@node.ToJsonString(new JsonSerializerOptions { WriteIndented = true })</pre>
}

@code {
    [Parameter]
    public CallToolResult? Result { get; set; }

    private static readonly JsonSerializerOptions Indented = new() { WriteIndented = true };

    private RenderFragment RenderRows(JsonArray array) => builder =>
    {
        if (array.Count == 0)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "text-muted");
            builder.AddContent(2, "(no rows)");
            builder.CloseElement();
            return;
        }

        var objects = array.OfType<JsonObject>().ToList();
        if (objects.Count != array.Count)
        {
            // Mixed / scalar array — fall back to raw JSON.
            builder.OpenElement(0, "pre");
            builder.AddAttribute(1, "class", "border rounded p-2 bg-light");
            builder.AddContent(2, array.ToJsonString(Indented));
            builder.CloseElement();
            return;
        }

        var columns = objects
            .SelectMany(o => o.Select(p => p.Key))
            .Distinct()
            .ToList();

        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "table-responsive");

        builder.OpenElement(seq++, "table");
        builder.AddAttribute(seq++, "class", "table table-striped table-bordered table-sm");

        builder.OpenElement(seq++, "thead");
        builder.OpenElement(seq++, "tr");
        foreach (var column in columns)
        {
            builder.OpenElement(seq++, "th");
            builder.AddContent(seq++, column);
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(seq++, "tbody");
        foreach (var obj in objects)
        {
            builder.OpenElement(seq++, "tr");
            foreach (var column in columns)
            {
                builder.OpenElement(seq++, "td");
                builder.AddContent(seq++, FormatCell(obj[column]));
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        builder.CloseElement();

        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(seq++, "p");
        builder.AddAttribute(seq++, "class", "text-muted");
        builder.AddContent(seq++, $"{array.Count} row(s).");
        builder.CloseElement();
    };

    private static string FormatCell(JsonNode? value) => value switch
    {
        null => "NULL",
        JsonValue v => v.ToString(),
        _ => value.ToJsonString(),
    };

    private static JsonNode? ExtractNode(CallToolResult result, out string? rawText)
    {
        rawText = null;

        string? json = null;
        if (result.StructuredContent is { } structured)
        {
            json = structured.GetRawText();
        }
        else
        {
            var text = string.Join(
                Environment.NewLine,
                result.Content.OfType<TextContentBlock>().Select(b => b.Text));
            json = string.IsNullOrWhiteSpace(text) ? null : text;
        }

        if (json is null)
        {
            return null;
        }

        try
        {
            return JsonNode.Parse(json);
        }
        catch (JsonException)
        {
            rawText = json;
            return null;
        }
    }
}
